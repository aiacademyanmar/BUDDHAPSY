# Set in web-server environment; never commit actual secrets.
DB_HOST=127.0.0.1
DB_NAME=buddha_care
DB_USER=care_app
DB_PASSWORD=REPLACE_WITH_SECRET
RATE_LIMIT_PEPPER=REPLACE_WITH_64_CHAR_RANDOM_SECRET
APP_ENV=production
# API must only be reachable over HTTPS. DB user should have least privileges.
ALLOW_MANUAL_CREDENTIAL_ACTIVATION=false
